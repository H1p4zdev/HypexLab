<?xml version="1.0" encoding="utf-8"?>
<!--
    HypexUI Lab — Privileged App Permissions
    Place in: /system/product/etc/permissions/ (or /system/etc/permissions/)
    This grants HypexUI Lab system-level permissions WITHOUT needing
    SettingsProvider patches.
    
    Integration in ROM build (BoardConfig.mk):
        PRODUCT_COPY_FILES += \
            device/hypex/permissions/privapp-permissions-hypexuilab.xml:$(TARGET_COPY_OUT_PRODUCT)/etc/permissions/privapp-permissions-hypexuilab.xml
-->
<permissions>
    <privapp-permissions package="com.hypexui.lab">
        <!-- Core system writes -->
        <permission name="android.permission.WRITE_SETTINGS"/>
        <permission name="android.permission.WRITE_SECURE_SETTINGS"/>
        
        <!-- Performance & GPU -->
        <permission name="android.permission.WRITE_SYSTEM_SETTINGS"/>
        
        <!-- Package management -->
        <permission name="android.permission.FORCE_STOP_PACKAGES"/>
        <permission name="android.permission.KILL_BACKGROUND_PROCESSES"/>
        <permission name="android.permission.REAL_GET_TASKS"/>
        <permission name="android.permission.PACKAGE_USAGE_STATS"/>
        
        <!-- Device power -->
        <permission name="android.permission.DEVICE_POWER"/>
        <permission name="android.permission.REBOOT"/>
        
        <!-- System properties (for HyperOS sysprop bridge) -->
        <permission name="android.permission.SET_PROPERTIES"/>
        
        <!-- Display -->
        <permission name="android.permission.CONFIGURE_DISPLAY_COLOR"/>
        <permission name="android.permission.CONTROL_DISPLAY_BRIGHTNESS"/>
        
        <!-- Status bar / QS -->
        <permission name="android.permission.STATUS_BAR"/>
        <permission name="android.permission.EXPAND_STATUS_BAR"/>
        
        <!-- Miscellaneous -->
        <permission name="android.permission.CHANGE_CONFIGURATION"/>
        <permission name="android.permission.MANAGE_USERS"/>
        <permission name="android.permission.INTERACT_ACROSS_USERS"/>
        <permission name="android.permission.INTERACT_ACROSS_USERS_FULL"/>
        <permission name="android.permission.SET_ACTIVITY_WATCHER"/>
        <permission name="android.permission.READ_PRECISE_PHONE_STATE"/>
        <permission name="android.permission.READ_FRAME_BUFFER"/>
        <permission name="android.permission.NET_ADMIN"/>
    </privapp-permissions>
</permissions>
